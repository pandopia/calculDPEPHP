{
  "name": "pandopia/calcul-dpe-php",
  "description": "Moteur PHP de calcul DPE 3CL-2021",
  "license": "MIT",
  "type": "library",
  "require": {
    "php": "^8.2",
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-gd": "*",
    "ext-mbstring": "*",
    "setasign/fpdi": "^2.6",
    "tecnickcom/tcpdf": "^6.10",
    "chillerlan/php-qrcode": "^5.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "CalculDpePHP\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/process-xml",
    "bin/calcul-dpe",
    "bin/dpe-pdf"
  ]
}
